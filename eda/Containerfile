FROM jupyter/pyspark-notebook:spark-3.5.0

# 1. Root only to create & chmod dirs that need to be writable
USER root

RUN mkdir -p /home/jovyan/.ivy2 \
    /home/jovyan/.sparkStaging \
    /home/jovyan/.local/share/jupyter/runtime \
    /tmp/.ivy2 \
    /tmp/spark \
    && chmod -R 777 /home/jovyan/.ivy2 \
    && chmod -R 777 /home/jovyan/.sparkStaging \
    && chmod -R 777 /home/jovyan/.local/share/jupyter/runtime \
    && chmod -R 777 /tmp/.ivy2 \
    && chmod -R 777 /tmp/spark

# 2. Switch to jovyan for everything else
USER jovyan
WORKDIR /home/jovyan

# 3. Install Python packages as jovyan (files owned by jovyan)
COPY eda/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 4. Copy project files
COPY . .

# 5. Ports and env
ENV JUPYTER_PORT=8888
ENV SPARK_UI_PORT=4040
ENV KAFKA_BROKER=kafka:9092
ENV KAFKA_TOPIC=customer

EXPOSE 8888 4040

# 6. Start Jupyter
CMD ["jupyter","lab","--ip=0.0.0.0","--port=8888","--no-browser","--NotebookApp.token=","--NotebookApp.password="]
