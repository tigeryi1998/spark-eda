FROM jupyter/pyspark-notebook:spark-3.5.0

# Root only to create & chmod dirs that need to be writable
USER root
WORKDIR /home/jovyan

# RUN mkdir -p /home/jovyan/.ivy2 \
#     /home/jovyan/.sparkStaging \
#     /home/jovyan/.local/share/jupyter/runtime \
#     /tmp/.ivy2 \
#     /tmp/spark \
#     && chmod -R 777 /home/jovyan/.ivy2 \
#     && chmod -R 777 /home/jovyan/.sparkStaging \
#     && chmod -R 777 /home/jovyan/.local/share/jupyter/runtime \
#     && chmod -R 777 /tmp/.ivy2 \
#     && chmod -R 777 /tmp/spark

# Install Python packages as jovyan (files owned by jovyan)
COPY eda/requirements.txt eda/requirements.txt
RUN pip install --no-cache-dir -r eda/requirements.txt

# Copy project files
COPY  eda/ eda/

RUN chown -R jovyan:users /home/jovyan/eda/

# Change the group ownership of the home directory to GID 0 (root group)
# and add group read write execute permissions. 
# This allows OpenShift's random UID
# (which is in GID 0) to write to the home directory.
RUN chgrp -R 0 /home/jovyan && chmod -R g+rwX /home/jovyan

# Switch to jovyan for everything else
USER jovyan
WORKDIR /home/jovyan

# Ports and env
ENV JUPYTER_PORT=8888
ENV SPARK_UI_PORT=4040
ENV KAFKA_BROKER=kafka:9092
ENV KAFKA_TOPIC=customer

EXPOSE 8888 4040

# 6. Start Jupyter
CMD ["jupyter","lab","--ip=0.0.0.0","--port=8888","--no-browser","--NotebookApp.token=","--NotebookApp.password="]
