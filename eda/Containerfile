FROM jupyter/pyspark-notebook:spark-3.5.0

USER root

# environment vars
ENV JUPYTER_PORT=8888
ENV SPARK_UI_PORT=4040
ENV KAFKA_BROKER=kafka:9092
ENV KAFKA_TOPIC=customer

# Set PySpark / temp dirs explicitly for OpenShift
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=jupyter
ENV PYSPARK_DRIVER_PYTHON_OPTS="lab --ip=0.0.0.0 --no-browser --NotebookApp.token='' --NotebookApp.password=''"

ENV SPARK_LOCAL_DIRS=/tmp/spark
ENV JUPYTER_RUNTIME_DIR=/tmp/jupyter-runtime
ENV JUPYTER_CONFIG_DIR=/tmp/jupyter-config
ENV JUPYTER_DATA_DIR=/tmp/jupyter-data

ENV IPYTHONDIR=/tmp/.ipython

WORKDIR /home/jovyan

# Install Python deps first
COPY eda/requirements.txt eda/requirements.txt
RUN pip install --no-cache-dir -r eda/requirements.txt

# Copy all project files while still root
COPY . .

# ---------------------------------------------
# Fix permissions ONCE for OpenShift
# ---------------------------------------------
RUN mkdir -p \
        /home/jovyan/.ivy2 \
        /home/jovyan/.cache \
        /home/jovyan/.python_history \
        /home/jovyan/.jupyter \
        /home/jovyan/.sparkStaging \
        /home/jovyan/.local/share/jupyter/runtime && \
    chmod -R 777 /home/jovyan /tmp

# ---------------------------------------------
# Switch to notebook user
# ---------------------------------------------
USER jovyan

EXPOSE 8888 4040

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--NotebookApp.token=", "--NotebookApp.password="]
