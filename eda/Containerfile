# Containerfile

# Base image
FROM jupyter/pyspark-notebook:spark-3.5.0

# ------------------------------------------------------
# Fix permissions for OpenShift
# ------------------------------------------------------
USER root

# /tmp must be writable for JVM + Spark
RUN chmod -R 777 /tmp

# Ensure key runtime dirs exist and are writable
RUN mkdir -p /home/jovyan/.ivy2 && chmod -R 777 /home/jovyan/.ivy2
RUN mkdir -p /home/jovyan/.cache && chmod -R 777 /home/jovyan/.cache

# Make project home writable (needed for Jupyter runtime)
RUN chmod -R 777 /home/jovyan

# Back to notebook user
USER ${NB_UID}

# ------------------------------------------------------
# Environment variables
# ------------------------------------------------------
ENV JUPYTER_PORT=8888
ENV SPARK_UI_PORT=4040
ENV KAFKA_BROKER=kafka:9092
ENV KAFKA_TOPIC=customer

# ------------------------------------------------------
# Working directory
# ------------------------------------------------------
WORKDIR /home/jovyan

# ------------------------------------------------------
# Install Python dependencies
# ------------------------------------------------------
COPY eda/requirements.txt eda/requirements.txt
RUN pip install --no-cache-dir -r eda/requirements.txt

# Copy rest of application code
COPY . .

# ------------------------------------------------------
# Expose ports
# ------------------------------------------------------
EXPOSE 8888
EXPOSE 4040

# ------------------------------------------------------
# Start JupyterLab
# ------------------------------------------------------
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--NotebookApp.token=", "--NotebookApp.password="]
