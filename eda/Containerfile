# Containerfile

# Base image (includes Python, Java, Spark, Jupyter)
FROM jupyter/pyspark-notebook:spark-3.5.0 

# ------------------------------------------------------
# Run as root to install packages and fix permissions
# ------------------------------------------------------
USER root

# ------------------------------------------------------
# Fix permissions for OpenShift
# ------------------------------------------------------

# Make /home/jovyan fully writable for any UID (needed for PySpark/Java)
RUN chmod -R 777 /home/jovyan
RUN chmod -R 777 /tmp

# Switch back to default notebook user (OpenShift may override UID)
USER ${NB_UID}

# ------------------------------------------------------


# environment variables
ENV JUPYTER_PORT=8888
ENV SPARK_UI_PORT=4040
ENV KAFKA_BROKER=kafka:9092
ENV KAFKA_TOPIC=customer

# working directory
WORKDIR /home/jovyan

# install python dependencies
COPY eda/requirements.txt eda/requirements.txt
RUN pip install --no-cache-dir -r eda/requirements.txt

# copy all application code
COPY . .

# expose ports
EXPOSE 8888
EXPOSE 4040

# command to run notebook
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--NotebookApp.token=", "--NotebookApp.password="]
