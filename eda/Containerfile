FROM jupyter/pyspark-notebook:spark-3.5.0

# Become root for setup
USER root

RUN chmod -R 777 /home/jovyan /tmp

# Switch to non-root (random UID in OpenShift)
USER jovyan

# Create important writable dirs for OpenShift
RUN mkdir -p /home/jovyan/.ivy2 \
    && mkdir -p /home/jovyan/.sparkStaging \
    && mkdir -p /home/jovyan/.local/share/jupyter/runtime \
    && mkdir -p /tmp/.ivy2 \
    && mkdir -p /tmp/spark 
    # && chgrp -R 0 /home/jovyan /tmp \
    # && chmod -R g+rwX /home/jovyan /tmp

# Switch to working directory
WORKDIR /home/jovyan

# Install Python requirements
COPY eda/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy project files
COPY . .

# Fix permissions again after copy
# RUN chgrp -R 0 /home/jovyan /tmp && chmod -R g+rwX /home/jovyan /tmp

# Ports
ENV JUPYTER_PORT=8888
ENV SPARK_UI_PORT=4040

# Kafka
ENV KAFKA_BROKER=kafka:9092
ENV KAFKA_TOPIC=customer

# Expose ports
EXPOSE 8888 4040

# Start Jupyter
CMD ["jupyter","lab","--ip=0.0.0.0","--port=8888","--no-browser","--NotebookApp.token=","--NotebookApp.password="]
