FROM jupyter/pyspark-notebook:spark-3.5.0

USER root

# environment vars
ENV JUPYTER_PORT=8888
ENV SPARK_UI_PORT=4040
ENV KAFKA_BROKER=kafka:9092
ENV KAFKA_TOPIC=customer

WORKDIR /home/jovyan

# Install Python deps first
COPY eda/requirements.txt eda/requirements.txt
RUN pip install --no-cache-dir -r eda/requirements.txt

# Copy all project files while still root
COPY . .

# ---------------------------------------------
# 🔥 Fix permissions ONCE for OpenShift
# ---------------------------------------------
# Spark needs these directories writable at runtime:
# - home directory (for .ivy2, caches, sparkStaging, etc.)
# - /tmp (Spark + Jupyter write here)
RUN mkdir -p \
        /home/jovyan/.ivy2 \
        /home/jovyan/.cache \
        /home/jovyan/.python_history \
        /home/jovyan/.jupyter \
        /home/jovyan/.sparkStaging \
        /home/jovyan/.local/share/jupyter/runtime

# Make EVERYTHING writable for random UID
RUN chmod -R 777 /home/jovyan && \
    chmod -R 777 /tmp

# ---------------------------------------------
# Switch to normal user only AFTER all setup
# ---------------------------------------------
USER ${NB_UID}

EXPOSE 8888 4040

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--NotebookApp.token=", "--NotebookApp.password="]
