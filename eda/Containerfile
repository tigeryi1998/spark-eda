# -----------------------------
# Base image
# -----------------------------
FROM jupyter/pyspark-notebook:spark-3.5.0

# -----------------------------
# Run as root for installations & permissions
# -----------------------------
USER root

# -----------------------------
# OpenShift-friendly permissions
# -----------------------------
# Make /home/jovyan and /tmp writable by any UID
RUN chmod -R 777 /home/jovyan /tmp

# -----------------------------
# Switch to notebook user
# -----------------------------
USER jovyan


# -----------------------------
# Environment variables
# -----------------------------
ENV JUPYTER_PORT=8888
ENV SPARK_UI_PORT=4040
ENV KAFKA_BROKER=kafka:9092
ENV KAFKA_TOPIC=customer

# PySpark / Jupyter temp directories
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=jupyter
ENV SPARK_LOCAL_DIRS=/tmp/spark
ENV JUPYTER_RUNTIME_DIR=/tmp/jupyter-runtime
ENV JUPYTER_CONFIG_DIR=/tmp/jupyter-config
ENV JUPYTER_DATA_DIR=/tmp/jupyter-data
ENV IPYTHONDIR=/tmp/.ipython

# Spark/Ivy directories (fix Java gateway issue)
ENV IVY_HOME=/tmp/.ivy2
ENV HADOOP_CONF_DIR=/tmp/hadoop-conf
RUN mkdir -p /tmp/.ivy2 /tmp/hadoop-conf && chmod -R 777 /tmp/.ivy2 /tmp/hadoop-conf

# -----------------------------
# Working directory
# -----------------------------
WORKDIR /home/jovyan

# -----------------------------
# Install Python dependencies
# -----------------------------
COPY eda/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# -----------------------------
# Copy project files
# -----------------------------
COPY . .

# -----------------------------
# Expose ports
# -----------------------------
EXPOSE 8888 4040

# -----------------------------
# Start Jupyter Lab
# -----------------------------
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--NotebookApp.token=", "--NotebookApp.password="]
